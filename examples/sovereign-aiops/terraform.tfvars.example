# Copy this file to terraform.tfvars and fill in your values.
# terraform.tfvars is gitignored — never commit real values.

project_name   = "sovereign-aiops"
aws_region     = "us-east-1"
environment    = "demo"
operator_email = "you@example.com"

# Networking
vpc_cidr             = "10.0.0.0/16"
private_subnet_cidrs = ["10.0.1.0/24", "10.0.2.0/24"]

# CloudTrail retention — 7 days is enough for a lab
cloudtrail_retention_days = 7

# MCP Server sizing — minimal for demo
mcp_server_cpu    = 256
mcp_server_memory = 512
